{
  "name": "shell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "webpack serve --config webpack.config.js --env development",
    "build": "webpack --config webpack.config.js --env production",
    "build:analyze": "webpack --config webpack.config.js --env production --env analyze",
    "build:stats": "webpack --config webpack.config.js --env production --json > dist/bundle-stats.json",
    "analyze": "webpack-bundle-analyzer dist/bundle-stats.json || echo 'Run pnpm build:stats first to generate bundle-stats.json'",
    "serve": "serve dist -l 3000",
    "serve:prod": "serve dist -l 3000 --single",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@design-system": "workspace:*",
    "@floating-ui/core": "^1.7.3",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.16",
    "@floating-ui/react-dom": "^2.1.6",
    "@floating-ui/utils": "^0.2.10",
    "@mantine/core": "^8.3.10",
    "@mantine/hooks": "^8.3.10",
    "@remix-run/router": "^1.19.1",
    "@types": "workspace:*",
    "api-client": "workspace:*",
    "k11-inbox": "workspace:*",
    "k11-monitoring": "workspace:*",
    "plugin-loader": "workspace:*",
    "plugin-registry": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-number-format": "^5.4.4",
    "clsx": "^2.1.1",
    "react-router": "^6.21.3",
    "react-router-dom": "^6.21.3",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/query-core": "^5.56.2",
    "detect-node-es": "^1.1.0",
    "get-nonce": "^1.0.1",
    "react-remove-scroll": "^2.5.7",
    "react-remove-scroll-bar": "^2.3.1",
    "react-style-singleton": "^2.2.2",
    "react-textarea-autosize": "^8.5.9",
    "scheduler": "^0.23.2",
    "tabbable": "^6.3.0",
    "tslib": "^2.6.2",
    "use-callback-ref": "^1.3.2",
    "use-composed-ref": "^1.4.0",
    "use-isomorphic-layout-effect": "^1.2.1",
    "use-latest": "^1.3.0",
    "use-sidecar": "^1.1.3"
