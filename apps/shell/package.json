    "@babel/preset-typescript": "^7.24.0",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/react-router-dom": "^5.3.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "dotenv": "^16.4.5",
    "dotenv-webpack": "^8.1.1",
    "events": "^3.3.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "html-webpack-plugin": "^5.6.0",
    "serve": "^14.2.5",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.90.0",
    "webpack-bundle-analyzer": "^5.0.1",
    "webpack-cli": "^5.1.4",
